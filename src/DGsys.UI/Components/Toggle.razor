<button type="button" role="switch" class="toggle @(Value ? "is-on" : null)" aria-checked="@(Value ? "true" : "false")"
        aria-label="@AriaLabel" @onclick="Flip">
    <span class="toggle__knob"></span>
</button>

@code {
    [Parameter] public bool Value { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter, EditorRequired] public string AriaLabel { get; set; } = "";

    private Task Flip() => ValueChanged.InvokeAsync(!Value);
}
