@page "/dashboard"
@page "/caisse"
@page "/comptabilite"
@page "/personnel"
@page "/configuration"
@inject NavigationManager Nav

@if (_module is not null)
{
    <PageTitle>@_module.Label – DGsys</PageTitle>
    <PageHeader Title="@_module.Label" Subtitle="@($"Espace {_module.Label.ToLower()} – accès rapide aux fonctionnalités.")" />

    @if (_module.Sections.Count == 0)
    {
        <p class="muted">Écran d'accueil à migrer.</p>
    }
    <div class="home-grid">
        @foreach (var s in _module.Sections)
        {
            <Card Title="@(s.Title ?? "")">
                @foreach (var e in s.Entries)
                {
                    <FeatureLink Label="@e.Label" Href="@e.Href" Icon="@e.Icon" />
                }
            </Card>
        }
    </div>
}

@code {
    private MenuModule? _module;
    protected override void OnParametersSet() => _module = NavigationCatalog.ModuleFor(Nav.ToBaseRelativePath(Nav.Uri));
}
