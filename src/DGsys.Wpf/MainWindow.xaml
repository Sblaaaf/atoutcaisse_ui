<Window x:Class="DGsys.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:ui="clr-namespace:DGsys.UI;assembly=DGsys.UI"
        Title="DGsys"
        WindowStyle="None" ResizeMode="CanResize" WindowState="Maximized"
        MinWidth="1024" MinHeight="700" Background="#2B3467">
    <!-- Fenêtre sans bordure : les boutons plein écran / réduire / fermer sont dans la barre DGsys (IWindowHost). -->
    <blazor:BlazorWebView x:Name="WebView" HostPage="wwwroot\index.html">
        <blazor:BlazorWebView.RootComponents>
            <blazor:RootComponent Selector="#app" ComponentType="{x:Type ui:DgsysApp}" />
        </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>
</Window>
